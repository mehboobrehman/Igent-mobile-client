{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "TelemetryEnvelope",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "deviceId",
    "seq",
    "timestamp",
    "wallTime",
    "type",
    "payload"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0.0"]
    },
    "sessionId": {
      "type": "string",
      "minLength": 1
    },
    "deviceId": {
      "type": "string",
      "minLength": 1
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "integer"
    },
    "wallTime": {
      "type": "integer"
    },
    "type": {
      "type": "string",
      "enum": [
        "logs",
        "crashes",
        "anrs",
        "network",
        "performance",
        "lifecycle",
        "state",
        "config",
        "commands",
        "heartbeats"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
